# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
# Only for testing the web build on a laptop, e.g. http://localhost:8081
CORS_ORIGINS=
# Speech service (speech/server.py)
SPEECH_URL=http://127.0.0.1:8000
# Only on Azure: the shared key the speech service asks for
SPEECH_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ganira
DB_PASSWORD=
DB_NAME=ganira_dev
# true on Azure (encrypted connection)
DB_SSL=false

# Test account from the SRS (parent "john" + one child). Never set in production.
TEST_ACCOUNT_EMAIL=john@ganira.test
TEST_ACCOUNT_USERNAME=john
TEST_ACCOUNT_PASSWORD=
